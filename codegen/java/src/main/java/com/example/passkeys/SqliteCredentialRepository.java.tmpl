package com.example.passkeys;

import com.yubico.webauthn.CredentialRepository;
import com.yubico.webauthn.RegisteredCredential;
import com.yubico.webauthn.data.AuthenticatorTransport;
import com.yubico.webauthn.data.ByteArray;
import com.yubico.webauthn.data.PublicKeyCredentialDescriptor;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.util.Arrays;
import java.util.HashSet;
import java.util.List;
import java.util.Optional;
import java.util.Set;
import java.util.stream.Collectors;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Repository;

/**
 * Stores users and passkeys in SQLite. The Yubico library looks up users and
 * credentials through the CredentialRepository interface.
 */
@Repository
public class SqliteCredentialRepository implements CredentialRepository {

  record User(ByteArray id, String name, String displayName) {}

  private final JdbcTemplate db;

  SqliteCredentialRepository(JdbcTemplate db) {
    this.db = db;
  }

  Optional<User> userByName(String name) {
    return db.query("SELECT id, name, display_name FROM users WHERE name = ?", this::user, name).stream().findFirst();
  }

  Optional<User> userById(ByteArray id) {
    return db.query("SELECT id, name, display_name FROM users WHERE id = ?", this::user, (Object) id.getBytes())
        .stream().findFirst();
  }

  private User user(ResultSet rs, int row) throws SQLException {
    return new User(new ByteArray(rs.getBytes("id")), rs.getString("name"), rs.getString("display_name"));
  }

  void addUser(User user) {
    db.update("INSERT INTO users (id, name, display_name) VALUES (?, ?, ?)",
        user.id().getBytes(), user.name(), user.displayName());
  }

  void addCredential(ByteArray userId, ByteArray credentialId, ByteArray publicKeyCose, long signCount,
      String transports, boolean backupEligible, boolean backupState, ByteArray aaguid, String attestationFormat) {
    db.update("""
        INSERT INTO credentials
          (id, user_id, public_key, sign_count, transports, backup_eligible, backup_state, aaguid, attestation_fmt)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)""",
        credentialId.getBytes(), userId.getBytes(), publicKeyCose.getBytes(), signCount, transports,
        backupEligible ? 1 : 0, backupState ? 1 : 0, aaguid.getBytes(), attestationFormat);
  }

  void updateAfterSignIn(ByteArray credentialId, long signCount, boolean backupState) {
    db.update("UPDATE credentials SET sign_count = ?, backup_state = ?, last_used_at = datetime('now') WHERE id = ?",
        signCount, backupState ? 1 : 0, credentialId.getBytes());
  }

  int countCredentials(ByteArray userId) {
    return db.queryForObject("SELECT count(*) FROM credentials WHERE user_id = ?", Integer.class, (Object) userId.getBytes());
  }

  // ---------- CredentialRepository ----------

  @Override
  public Set<PublicKeyCredentialDescriptor> getCredentialIdsForUsername(String username) {
    List<PublicKeyCredentialDescriptor> list = db.query("""
        SELECT c.id, c.transports FROM credentials c JOIN users u ON u.id = c.user_id WHERE u.name = ?""",
        (rs, row) -> PublicKeyCredentialDescriptor.builder()
            .id(new ByteArray(rs.getBytes("id")))
            .transports(transports(rs.getString("transports")))
            .build(),
        username);
    return new HashSet<>(list);
  }

  @Override
  public Optional<ByteArray> getUserHandleForUsername(String username) {
    return userByName(username).map(User::id);
  }

  @Override
  public Optional<String> getUsernameForUserHandle(ByteArray userHandle) {
    return userById(userHandle).map(User::name);
  }

  @Override
  public Optional<RegisteredCredential> lookup(ByteArray credentialId, ByteArray userHandle) {
    return lookupAll(credentialId).stream().filter(c -> c.getUserHandle().equals(userHandle)).findFirst();
  }

  @Override
  public Set<RegisteredCredential> lookupAll(ByteArray credentialId) {
    List<RegisteredCredential> list = db.query("SELECT * FROM credentials WHERE id = ?",
        (rs, row) -> RegisteredCredential.builder()
            .credentialId(new ByteArray(rs.getBytes("id")))
            .userHandle(new ByteArray(rs.getBytes("user_id")))
            .publicKeyCose(new ByteArray(rs.getBytes("public_key")))
            .signatureCount(rs.getLong("sign_count"))
            .transports(transports(rs.getString("transports")))
            // The library rejects a sign-in whose backup eligibility differs.
            .backupEligible(rs.getInt("backup_eligible") == 1)
            .backupState(rs.getInt("backup_state") == 1)
            .build(),
        (Object) credentialId.getBytes());
    return new HashSet<>(list);
  }

  private static Set<AuthenticatorTransport> transports(String csv) {
    return Arrays.stream(csv.split(",")).filter(s -> !s.isEmpty()).map(AuthenticatorTransport::of)
        .collect(Collectors.toSet());
  }
}
