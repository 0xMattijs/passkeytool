// Command server is a passkey sign-in server for {{.RPName}}, built with
// go-webauthn. It serves the page in public/ and stores data in SQLite.
package main

import (
	"bytes"
	"crypto/rand"
	"database/sql"
	_ "embed"
	"encoding/base64"
	"encoding/json"
	"errors"
	"log"
	"net/http"
	"os"
	"strings"
	"sync"

	"github.com/go-webauthn/webauthn/protocol"
	"github.com/go-webauthn/webauthn/webauthn"
	_ "modernc.org/sqlite"
)

//go:embed schema.sql
var schema string

func main() {
	db, err := sql.Open("sqlite", "passkeys.db?_pragma=foreign_keys(1)")
	if err != nil {
		log.Fatal(err)
	}
	if _, err := db.Exec(schema); err != nil {
		log.Fatal(err)
	}

	wa, err := webauthn.New(&webauthn.Config{
		RPID:          {{printf "%q" .RPID}},
		RPDisplayName: {{printf "%q" .RPName}},
		RPOrigins:     []string{ {{- printf "%q" .Origin -}} },
	})
	if err != nil {
		log.Fatal(err)
	}

	s := &server{db: db, wa: wa, sessions: map[string]*session{}}
	mux := http.NewServeMux()
	mux.Handle("GET /", http.FileServer(http.Dir("public")))
	mux.HandleFunc("POST /api/register/begin", s.registerBegin)
	mux.HandleFunc("POST /api/register/finish", s.registerFinish)
	mux.HandleFunc("POST /api/login/begin", s.loginBegin)
	mux.HandleFunc("POST /api/login/finish", s.loginFinish)
	mux.HandleFunc("GET /api/me", s.me)
	mux.HandleFunc("POST /api/logout", s.logout)

	port := os.Getenv("PORT")
	if port == "" {
		port = {{printf "%q" .Port}}
	}
	log.Printf("listening on :%s, open {{.Origin}}", port)
	log.Fatal(http.ListenAndServe(":"+port, mux))
}

// ---------- users and credentials ----------

// user implements webauthn.User.
type user struct {
	id          []byte
	name        string
	displayName string
	credentials []webauthn.Credential
}

func (u *user) WebAuthnID() []byte                         { return u.id }
func (u *user) WebAuthnName() string                       { return u.name }
func (u *user) WebAuthnDisplayName() string                { return u.displayName }
func (u *user) WebAuthnCredentials() []webauthn.Credential { return u.credentials }

type server struct {
	db *sql.DB
	wa *webauthn.WebAuthn

	mu       sync.Mutex
	sessions map[string]*session
}

// loadUser reads a user and their credentials by name or by ID.
func (s *server) loadUser(where string, arg any) (*user, error) {
	u := &user{}
	err := s.db.QueryRow("SELECT id, name, display_name FROM users WHERE "+where+" = ?", arg).
		Scan(&u.id, &u.name, &u.displayName)
	if err != nil {
		return nil, err
	}
	rows, err := s.db.Query(`SELECT id, public_key, sign_count, transports, backup_eligible, backup_state, aaguid
		FROM credentials WHERE user_id = ?`, u.id)
	if err != nil {
		return nil, err
	}
	defer rows.Close()
	for rows.Next() {
		var c webauthn.Credential
		var transports string
		if err := rows.Scan(&c.ID, &c.PublicKey, &c.Authenticator.SignCount, &transports,
			&c.Flags.BackupEligible, &c.Flags.BackupState, &c.Authenticator.AAGUID); err != nil {
			return nil, err
		}
		for _, t := range strings.Split(transports, ",") {
			if t != "" {
				c.Transport = append(c.Transport, protocol.AuthenticatorTransport(t))
			}
		}
		u.credentials = append(u.credentials, c)
	}
	return u, rows.Err()
}

// ---------- sessions ----------

// session holds ceremony state between the begin and finish requests.
// Production apps should use a real session store with expiry.
type session struct {
	userID []byte // signed-in user

	reg        *webauthn.SessionData // pending registration
	regUser    *user
	regNewUser bool

	// Pending sign-ins, keyed by challenge: an autofill request and a
	// button-triggered one can be in flight at the same time.
	logins map[string]*webauthn.SessionData
}

func (s *server) session(w http.ResponseWriter, r *http.Request) *session {
	s.mu.Lock()
	defer s.mu.Unlock()
	if c, err := r.Cookie("sid"); err == nil {
		if sess, ok := s.sessions[c.Value]; ok {
			return sess
		}
	}
	id := randomID()
	sess := &session{logins: map[string]*webauthn.SessionData{}}
	s.sessions[id] = sess
	http.SetCookie(w, &http.Cookie{Name: "sid", Value: id, Path: "/", HttpOnly: true, SameSite: http.SameSiteLaxMode, Secure: {{.Secure}}})
	return sess
}

func randomBytes(n int) []byte {
	b := make([]byte, n)
	if _, err := rand.Read(b); err != nil {
		panic(err)
	}
	return b
}

func randomID() string { return base64.RawURLEncoding.EncodeToString(randomBytes(32)) }

// ---------- registration ----------

func (s *server) registerBegin(w http.ResponseWriter, r *http.Request) {
	var req struct {
		Username    string `json:"username"`
		DisplayName string `json:"displayName"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, err)
		return
	}
	sess := s.session(w, r)

	// Signed in: add a passkey to the account. Otherwise: a new account,
	// which is only stored once the passkey is verified.
	s.mu.Lock()
	signedIn := sess.userID
	s.mu.Unlock()
	var u *user
	newUser := signedIn == nil
	if !newUser {
		var err error
		if u, err = s.loadUser("id", signedIn); err != nil {
			writeError(w, http.StatusInternalServerError, err)
			return
		}
	} else {
		name := strings.TrimSpace(req.Username)
		if name == "" {
			writeError(w, http.StatusBadRequest, errors.New("username is required"))
			return
		}
		if _, err := s.loadUser("name", name); err == nil {
			writeError(w, http.StatusConflict, errors.New("that username is taken"))
			return
		}
		display := strings.TrimSpace(req.DisplayName)
		if display == "" {
			display = name
		}
		// The user handle is random: it's stored on the authenticator and
		// must not contain personal data.
		u = &user{id: randomBytes(32), name: name, displayName: display}
	}

	selection := protocol.AuthenticatorSelection{
		ResidentKey:      protocol.ResidentKeyRequirement({{printf "%q" .ResidentKey}}),
		UserVerification: protocol.UserVerificationRequirement({{printf "%q" .UserVerification}}),
{{- if .Attachment}}
		AuthenticatorAttachment: protocol.AuthenticatorAttachment({{printf "%q" .Attachment}}),
{{- end}}
	}
{{- if eq .ResidentKey "required"}}
	selection.RequireResidentKey = protocol.ResidentKeyRequired()
{{- end}}
	opts := []webauthn.RegistrationOption{
		webauthn.WithAuthenticatorSelection(selection),
		webauthn.WithConveyancePreference(protocol.ConveyancePreference({{printf "%q" .Attestation}})),
{{- if .Hints}}
		webauthn.WithPublicKeyCredentialHints([]protocol.PublicKeyCredentialHints{ {{- goHints .Hints -}} }),
{{- end}}
{{- if or .CredProps .PRF}}
		webauthn.WithExtensions(
{{- if .CredProps}}
			webauthn.WithExtensionCredProps(),
{{- end}}
{{- if .PRF}}
			webauthn.WithExtensionPRFSupport(),
{{- end}}
		),
{{- end}}
	}
{{- if .ExcludeExisting}}
	// Stop the user from registering the same authenticator twice.
	var exclude []protocol.CredentialDescriptor
	for _, c := range u.credentials {
		exclude = append(exclude, c.Descriptor())
	}
	opts = append(opts, webauthn.WithExclusions(exclude))
{{- end}}

	creation, sd, err := s.wa.BeginRegistration(u, opts...)
	if err != nil {
		writeError(w, http.StatusInternalServerError, err)
		return
	}
	s.mu.Lock()
	sess.reg, sess.regUser, sess.regNewUser = sd, u, newUser
	s.mu.Unlock()
	writeJSON(w, creation.Response)
}

func (s *server) registerFinish(w http.ResponseWriter, r *http.Request) {
	sess := s.session(w, r)
	s.mu.Lock()
	sd, u, newUser := sess.reg, sess.regUser, sess.regNewUser
	sess.reg, sess.regUser = nil, nil // a challenge is single-use
	s.mu.Unlock()
	if sd == nil {
		writeError(w, http.StatusBadRequest, errors.New("no registration in progress"))
		return
	}

	parsed, err := protocol.ParseCredentialCreationResponseBody(r.Body)
	if err != nil {
		writeError(w, http.StatusBadRequest, describe(err))
		return
	}
	cred, err := s.wa.CreateCredential(u, *sd, parsed)
	if err != nil {
		writeError(w, http.StatusBadRequest, describe(err))
		return
	}

	var transports []string
	for _, t := range cred.Transport {
		transports = append(transports, string(t))
	}
	tx, err := s.db.Begin()
	if err != nil {
		writeError(w, http.StatusInternalServerError, err)
		return
	}
	defer tx.Rollback()
	if newUser {
		if _, err := tx.Exec("INSERT INTO users (id, name, display_name) VALUES (?, ?, ?)", u.id, u.name, u.displayName); err != nil {
			writeError(w, http.StatusConflict, errors.New("that username is taken"))
			return
		}
	}
	_, err = tx.Exec(`INSERT INTO credentials
		(id, user_id, public_key, sign_count, transports, backup_eligible, backup_state, aaguid, attestation_fmt)
		VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`,
		cred.ID, u.id, cred.PublicKey, cred.Authenticator.SignCount, strings.Join(transports, ","),
		cred.Flags.BackupEligible, cred.Flags.BackupState, cred.Authenticator.AAGUID, cred.AttestationFormat)
	if err != nil {
		writeError(w, http.StatusInternalServerError, err)
		return
	}
	if err := tx.Commit(); err != nil {
		writeError(w, http.StatusInternalServerError, err)
		return
	}

	s.mu.Lock()
	sess.userID = u.id
	s.mu.Unlock()
	writeJSON(w, map[string]string{"username": u.name})
}

// ---------- sign-in ----------

func (s *server) loginBegin(w http.ResponseWriter, r *http.Request) {
	var req struct {
		Username string `json:"username"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, err)
		return
	}
	sess := s.session(w, r)

	opts := []webauthn.LoginOption{
		webauthn.WithUserVerification(protocol.UserVerificationRequirement({{printf "%q" .UserVerification}})),
{{- if .Hints}}
		webauthn.WithAssertionPublicKeyCredentialHints([]protocol.PublicKeyCredentialHints{ {{- goHints .Hints -}} }),
{{- end}}
{{- if .PRF}}
		// Derive a secret from the passkey. The salt can be per user or per
		// purpose; the same passkey and salt always give the same secret.
		webauthn.WithAssertionExtensions(webauthn.WithExtensionPRF(protocol.PRFValues{First: []byte({{printf "%q" .PRFSalt}})})),
{{- end}}
	}

	var (
		assertion *protocol.CredentialAssertion
		sd        *webauthn.SessionData
		err       error
	)
	// With a known username, list that user's passkeys. Otherwise (no
	// username, or an unknown one, so the response doesn't reveal which
	// accounts exist), let the browser offer any passkey for this site.
	u, lookupErr := s.loadUser("name", strings.TrimSpace(req.Username))
	if req.Username != "" && lookupErr == nil && len(u.credentials) > 0 {
		assertion, sd, err = s.wa.BeginLogin(u, opts...)
	} else {
		assertion, sd, err = s.wa.BeginDiscoverableLogin(opts...)
	}
	if err != nil {
		writeError(w, http.StatusInternalServerError, err)
		return
	}
	s.mu.Lock()
	if len(sess.logins) >= 8 {
		clear(sess.logins)
	}
	sess.logins[sd.Challenge] = sd
	s.mu.Unlock()
	writeJSON(w, assertion.Response)
}

func (s *server) loginFinish(w http.ResponseWriter, r *http.Request) {
	sess := s.session(w, r)
	parsed, err := protocol.ParseCredentialRequestResponseBody(r.Body)
	if err != nil {
		writeError(w, http.StatusBadRequest, describe(err))
		return
	}
	s.mu.Lock()
	challenge := parsed.Response.CollectedClientData.Challenge
	sd := sess.logins[challenge]
	delete(sess.logins, challenge) // a challenge is single-use
	s.mu.Unlock()
	if sd == nil {
		writeError(w, http.StatusBadRequest, errors.New("unknown or expired challenge"))
		return
	}

	// Find the account from the credential ID, and check that the user
	// handle the authenticator returned belongs to the same account.
	var owner *user
	findOwner := func(rawID, userHandle []byte) (webauthn.User, error) {
		var userID []byte
		if err := s.db.QueryRow("SELECT user_id FROM credentials WHERE id = ?", rawID).Scan(&userID); err != nil {
			return nil, errors.New("unknown passkey")
		}
		if len(userHandle) > 0 && !bytes.Equal(userHandle, userID) {
			return nil, errors.New("passkey does not belong to this user")
		}
		u, err := s.loadUser("id", userID)
		owner = u
		return u, err
	}

	var cred *webauthn.Credential
	if len(sd.UserID) == 0 {
		_, cred, err = s.wa.ValidatePasskeyLogin(findOwner, *sd, parsed)
	} else {
		var u webauthn.User
		if u, err = findOwner(parsed.RawID, parsed.Response.UserHandle); err == nil {
			if !bytes.Equal(u.WebAuthnID(), sd.UserID) {
				err = errors.New("passkey does not belong to this user")
			} else {
				cred, err = s.wa.ValidateLogin(u, *sd, parsed)
			}
		}
	}
	if err != nil {
		writeError(w, http.StatusUnauthorized, describe(err))
		return
	}

	if cred.Authenticator.CloneWarning {
		// The sign count went backwards: the authenticator may be cloned.
		// Decide on a policy, for example asking for another factor.
		log.Printf("clone warning for a passkey of user %s", owner.name)
	}
	_, err = s.db.Exec(`UPDATE credentials SET sign_count = ?, backup_state = ?, last_used_at = datetime('now')
		WHERE id = ?`, cred.Authenticator.SignCount, cred.Flags.BackupState, cred.ID)
	if err != nil {
		writeError(w, http.StatusInternalServerError, err)
		return
	}

	s.mu.Lock()
	sess.userID = owner.id
	s.mu.Unlock()
	writeJSON(w, map[string]string{"username": owner.name})
}

// ---------- account ----------

func (s *server) me(w http.ResponseWriter, r *http.Request) {
	sess := s.session(w, r)
	s.mu.Lock()
	id := sess.userID
	s.mu.Unlock()
	if id == nil {
		writeError(w, http.StatusUnauthorized, errors.New("not signed in"))
		return
	}
	u, err := s.loadUser("id", id)
	if err != nil {
		writeError(w, http.StatusUnauthorized, errors.New("not signed in"))
		return
	}
	writeJSON(w, map[string]any{"username": u.name, "passkeys": len(u.credentials)})
}

func (s *server) logout(w http.ResponseWriter, r *http.Request) {
	sess := s.session(w, r)
	s.mu.Lock()
	sess.userID = nil
	s.mu.Unlock()
	writeJSON(w, map[string]bool{"ok": true})
}

// ---------- helpers ----------

func writeJSON(w http.ResponseWriter, v any) {
	w.Header().Set("Content-Type", "application/json")
	_ = json.NewEncoder(w).Encode(v)
}

func writeError(w http.ResponseWriter, status int, err error) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	_ = json.NewEncoder(w).Encode(map[string]string{"error": err.Error()})
}

// describe adds go-webauthn's detailed reason to an error.
func describe(err error) error {
	var pe *protocol.Error
	if errors.As(err, &pe) && pe.DevInfo != "" {
		return errors.New(pe.Details + ": " + pe.DevInfo)
	}
	return err
}
